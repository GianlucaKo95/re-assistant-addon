{
  "name": "RE-Assistent",
  "version": "4.3.7",
  "slug": "re_assistant",
  "description": "KI-gestütztes Requirements Engineering — PostgreSQL, WebSockets, Enterprise-ready.",
  "url": "https://github.com/GianlucaKo95/re-assistant-addon",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "homeassistant_api": false,
  "hassio_api": false,
  "options": {
    "admin_password": "admin123",
    "language": "de",
    "log_level": "info",
    "database_url": "",
    "trusted_proxy_hops": 1
  },
  "schema": {
    "admin_password": "str",
    "language": "list(de|en)",
    "log_level": "list(trace|debug|info|notice|warning|error|fatal)",
    "database_url": "str?",
    "trusted_proxy_hops": "int(0,10)"
  },
  "map": [
    "data:rw"
  ],
  "environment": {
    "ADMIN_PASSWORD": "{{admin_password}}",
    "LANGUAGE": "{{language}}",
    "LOG_LEVEL": "{{log_level}}",
    "DATABASE_URL": "{{database_url}}",
    "TRUSTED_PROXY_HOPS": "{{trusted_proxy_hops}}"
  },
  "ports": {
    "3000/tcp": 3000
  }
}