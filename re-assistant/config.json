{
  "name": "RE-Assistent",
  "version": "0.0.1",
  "slug": "re_assistant",
  "description": "KI-gest\u00fctztes Requirements Engineering \u2014 PostgreSQL, WebSockets, Enterprise-ready.",
  "url": "https://github.com/GianlucaKo95/re-assistant-addon",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "homeassistant_api": false,
  "hassio_api": false,
  "options": {
    "anthropic_api_key": "",
    "admin_password": "admin123",
    "language": "de",
    "log_level": "info",
    "database_url": ""
  },
  "schema": {
    "anthropic_api_key": "str",
    "admin_password": "str",
    "language": "list(de|en)",
    "log_level": "list(trace|debug|info|notice|warning|error|fatal)",
    "database_url": "str?"
  },
  "map": [
    "data:rw"
  ],
  "environment": {
    "ANTHROPIC_API_KEY": "{{anthropic_api_key}}",
    "ADMIN_PASSWORD": "{{admin_password}}",
    "LANGUAGE": "{{language}}",
    "LOG_LEVEL": "{{log_level}}",
    "DATABASE_URL": "{{database_url}}"
  },
  "ports": {
    "3000/tcp": 3000
  }
}